{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": ".types",
    "rootDir": "packages",
    "jsx": "react-jsx",
    "emitDeclarationOnly": true,
    "baseUrl": ".",
    "paths": {
      "@weavour/editor": [
        "packages/editor/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx"
  ]
}
