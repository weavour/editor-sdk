{
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weavour/editor-sdk.git"
  },
  "homepage": "https://github.com/weavour/editor-sdk#readme",
  "bugs": "https://github.com/weavour/editor-sdk/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "name": "@weavour/editor",
