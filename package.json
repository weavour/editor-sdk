{
  "name": "weavour-editor-sdk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:packages": "node scripts/check-packages.mjs",
    "verify": "npm run check && npm test && npm run test:packages",
    "version:sdk": "node scripts/version.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.11",
    "happy-dom": "^20.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3"
  }
}
